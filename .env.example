# Copy to .env and fill in. Never commit .env.

# --- Claude API (used from Stage 3: AI highlights) ---
ANTHROPIC_API_KEY=
TWAPZA_CLAUDE_MODEL=claude-sonnet-5-5

# --- Limits ---
TWAPZA_MAX_UPLOAD_GB=20
TWAPZA_MAX_DURATION_MIN=180
TWAPZA_CHUNK_SIZE_MB=16
TWAPZA_RETENTION_HOURS=24
TWAPZA_CLEANUP_INTERVAL_SECONDS=900

# --- Storage (Docker Compose overrides these to use the twapza-data volume) ---
TWAPZA_STORAGE_BACKEND=local
TWAPZA_STORAGE_ROOT=./data/storage
TWAPZA_DATABASE_URL=sqlite:///./data/twapza.db

# --- Queue ---
REDIS_URL=redis://localhost:6379/0
TWAPZA_JOB_TIMEOUT_SECONDS=21600

# --- Processing ---
TWAPZA_PROXY_HEIGHT=720
# x264 preset/quality for exported clips (slower preset = smaller files)
TWAPZA_EXPORT_PRESET=veryfast
TWAPZA_EXPORT_CRF=20

# --- Transcription (faster-whisper, runs locally on CPU) ---
TWAPZA_TRANSCRIBER=faster_whisper
# tiny | base | small | medium | large-v3   (bigger = more accurate, slower)
TWAPZA_WHISPER_MODEL=small
TWAPZA_WHISPER_DEVICE=cpu
TWAPZA_WHISPER_COMPUTE_TYPE=int8
# Leave empty to auto-detect, or set e.g. en / nl
TWAPZA_WHISPER_LANGUAGE=
TWAPZA_WHISPER_MODEL_DIR=./data/models

# --- Simple clipping ---
TWAPZA_SNAP_WINDOW_SECONDS=5
TWAPZA_MIN_CLIP_SECONDS=15
TWAPZA_MAX_CLIP_SECONDS=180
