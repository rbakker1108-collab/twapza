# Copy to .env and fill in. Never commit .env.

# --- Claude API (AI highlights) ---
# Get a key at https://console.anthropic.com/ . Never commit it.
ANTHROPIC_API_KEY=
TWAPZA_CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max  (higher = more careful picks, more tokens)
TWAPZA_CLAUDE_EFFORT=high
# Transcript parts sent to Claude at the same time
TWAPZA_CLAUDE_CONCURRENCY=4

# --- AI highlights ---
TWAPZA_HIGHLIGHT_CHUNK_SECONDS=480
TWAPZA_HIGHLIGHT_OVERLAP_SECONDS=60
TWAPZA_HIGHLIGHTS_PER_CHUNK=5
TWAPZA_MAX_HIGHLIGHTS=30
TWAPZA_HIGHLIGHT_MIN_SECONDS=15
TWAPZA_HIGHLIGHT_MAX_SECONDS=90

# --- Limits ---
TWAPZA_MAX_UPLOAD_GB=20
TWAPZA_MAX_DURATION_MIN=180
TWAPZA_CHUNK_SIZE_MB=16
TWAPZA_RETENTION_HOURS=24
TWAPZA_CLEANUP_INTERVAL_SECONDS=900

# --- YouTube link import (yt-dlp). Only import videos you own or may use. ---
TWAPZA_YOUTUBE_ENABLED=true
# Highest resolution to download (clips are exported at up to 1080p anyway)
TWAPZA_YOUTUBE_MAX_HEIGHT=1080

# --- Storage (Docker Compose overrides these to use the twapza-data volume) ---
TWAPZA_STORAGE_BACKEND=local
TWAPZA_STORAGE_ROOT=./data/storage
TWAPZA_DATABASE_URL=sqlite:///./data/twapza.db

# --- Queue ---
REDIS_URL=redis://localhost:6379/0
TWAPZA_JOB_TIMEOUT_SECONDS=21600

# --- Processing ---
TWAPZA_PROXY_HEIGHT=720
# x264 preset/quality for exported clips (slower preset = smaller files)
TWAPZA_EXPORT_PRESET=veryfast
TWAPZA_EXPORT_CRF=20

# --- Transcription (faster-whisper, runs locally on CPU) ---
TWAPZA_TRANSCRIBER=faster_whisper
# tiny | base | small | medium | large-v3   (bigger = more accurate, slower)
TWAPZA_WHISPER_MODEL=small
TWAPZA_WHISPER_DEVICE=cpu
TWAPZA_WHISPER_COMPUTE_TYPE=int8
# Leave empty to auto-detect, or set e.g. en / nl
TWAPZA_WHISPER_LANGUAGE=
TWAPZA_WHISPER_MODEL_DIR=./data/models

# --- Simple clipping ---
TWAPZA_SNAP_WINDOW_SECONDS=5
TWAPZA_MIN_CLIP_SECONDS=15
TWAPZA_MAX_CLIP_SECONDS=180

# --- Production (docker-compose.prod.yml: HTTPS via Caddy) ---
# The address people use; twapza.io redirects to it. The prod compose file also sets
# TWAPZA_PUBLIC_URL=https://$TWAPZA_DOMAIN for the API.
TWAPZA_DOMAIN=www.twapza.io
TWAPZA_REDIRECT_DOMAIN=twapza.io

# --- Accounts ---
# Where people open Twapza: used in password-reset emails and as the return address after paying.
# Use your https:// address in production (this also makes the login cookie Secure).
TWAPZA_PUBLIC_URL=http://localhost:8080
TWAPZA_SESSION_DAYS=30
# Proxies in front of the API that add X-Forwarded-For (1 = nginx; prod compose sets 2 = Caddy + nginx)
TWAPZA_TRUSTED_PROXY_HOPS=1
# Email for password resets (any SMTP service: Resend, Postmark, Brevo, your mail host, ...).
# Leave TWAPZA_SMTP_HOST empty to write reset links to the API log instead.
TWAPZA_SMTP_HOST=
TWAPZA_SMTP_PORT=587
TWAPZA_SMTP_USERNAME=
TWAPZA_SMTP_PASSWORD=
TWAPZA_SMTP_FROM=Twapza <no-reply@twapza.io>
TWAPZA_SMTP_STARTTLS=true

# --- Payments (Stripe, see README "Accounts and payments") ---
# Leave the secret key empty to run without paid plans (set plans by hand: python -m twapza.users set-plan).
# Test mode first: sk_test_... and the test webhook secret. Never commit real keys.
TWAPZA_STRIPE_SECRET_KEY=
TWAPZA_STRIPE_WEBHOOK_SECRET=
# Stripe Managed Payments: Stripe is the merchant of record (VAT/sales tax, fraud, disputes)
TWAPZA_STRIPE_MANAGED_PAYMENTS=true
# Printed by: python -m twapza.stripe_setup
TWAPZA_STRIPE_PRICE_CREATOR_MONTHLY=
TWAPZA_STRIPE_PRICE_CREATOR_YEARLY=
TWAPZA_STRIPE_PRICE_PRO_MONTHLY=
TWAPZA_STRIPE_PRICE_PRO_YEARLY=
TWAPZA_STRIPE_PORTAL_CONFIGURATION=
